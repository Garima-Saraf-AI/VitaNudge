# Copy this file to .env and fill in your values
# NEVER commit .env to git

PORT=5001
NODE_ENV=development

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_96_CHAR_STRING

# AI Provider for food scan (gemini is free)
SCAN_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# Email (for weekly reports) - free at resend.com
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=YourApp <onboarding@resend.dev>
WEEKLY_EMAIL_SCHEDULER=on
WEEKLY_EMAIL_DAY=0
WEEKLY_EMAIL_HOUR=8

# Frontend URL (change to your Render URL in production)
FRONTEND_URL=http://localhost:3000
